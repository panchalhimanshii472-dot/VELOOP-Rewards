# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection (use your local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/veloop_daily_streak

# JWT Configuration (use a strong random secret in your local .env)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20
CLAIM_RATE_LIMIT_MAX=60

