{
  "info": {
    "name": "VELoop Rewards - Daily Streak API",
    "_postman_id": "a9d4f7a1-6b12-4c9a-9f8e-202611110001",
    "description": "Complete Postman collection for VELoop Rewards Daily Streak API including happy-path flow and security negative tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Fresh User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman.tester@velooprewards.in\",\n  \"password\": \"VeloopDemo@2026\"\n}"
            }
          }
        },
        {
          "name": "Login Demo User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fresh@velooprewards.in\",\n  \"password\": \"VeloopDemo@2026\"\n}"
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update Profile Name",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Daily Streak Happy Path",
      "item": [
        {
          "name": "Get Daily Streak Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Get Daily Streak Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/status"
          }
        },
        {
          "name": "Initiate Claim (Pre-CPA Demo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim/initiate",
            "body": { "mode": "raw", "raw": "{\n  \"day\": 1\n}" }
          }
        },
        {
          "name": "Claim Day 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-day1-001" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{\n  \"day\": 1\n}" }
          }
        },
        {
          "name": "Get Updated Streak",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Claim Day 2 (Expect 409 Locked Until 24h Cooldown)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{\n  \"day\": 2\n}" }
          }
        },
        {
          "name": "Get Streak History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/history"
          }
        },
        {
          "name": "Get Wallet & Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    },
    {
      "name": "Security & Negative Tests",
      "item": [
        {
          "name": "Unauthorized Request (No Token -> 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Fake Day Jump (Day 7 -> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{\n  \"day\": 7\n}" }
          }
        },
        {
          "name": "Fake Reward & Currency Tampering (-> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 2,\n  \"reward\": 100000,\n  \"currency\": \"VES\"\n}"
            }
          }
        },
        {
          "name": "Cross-User Ownership Manipulation (-> 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"anotherUser\",\n  \"day\": 2\n}"
            }
          }
        },
        {
          "name": "Duplicate Day 1 Claim (-> 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{\n  \"day\": 1\n}" }
          }
        }
      ]
    }
  ]
}

